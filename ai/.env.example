# ==========================================
# AI shot — AI 管线环境变量配置
# 复制此文件为 .env 并填入实际值
# ==========================================

# --- 数据库 ---
DB_DSN=postgres://aishot:aishot@postgres:5432/aishot?sslmode=disable
REDIS_ADDR=redis:6379
RABBITMQ_ADDR=amqp://guest:guest@rabbitmq:5672/

# --- LLM 翻译（OpenAI 兼容接口）---
OPENAI_API_KEY=sk-your-openai-api-key
# LLM_BASE_URL=https://api.deepseek.com/v1   # DeepSeek 等兼容提供商
# LLM_MODEL=gpt-4o-mini                       # 默认，性价比最高
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# --- Whisper 模型 ---
# 可选: tiny / base / small / medium / large-v3
# 本地开发用 base，生产用 large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# WHISPER_DEVICE=cuda

# --- 对象存储 ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aishot-videos

# --- API Gateway 回调地址 ---
API_GATEWAY_URL=http://api-gateway:8080/api/v1

# --- 日志 ---
LOG_LEVEL=INFO
