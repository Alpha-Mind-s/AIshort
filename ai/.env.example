# ==========================================
# AI shot — AI 管线环境变量配置
# 复制此文件为 .env 并填入实际值
# ==========================================

# --- 数据库 ---
DB_DSN=postgres://aishot:aishot@postgres:5432/aishot?sslmode=disable
REDIS_ADDR=redis:6379
RABBITMQ_ADDR=amqp://guest:guest@rabbitmq:5672/

# ==========================================
# 翻译模式（二选一）
# ==========================================
# 模式A: 本地免费 (Ollama) — 无需 API Key，默认开启
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen3:4b
#   OPENAI_API_KEY=ollama    (填任意值即可)

# 模式B: 云端在线 (OpenAI / DeepSeek) — 填 API Key 后自动切换
#   OPENAI_API_KEY=sk-your-key-here
#   LLM_BASE_URL=            (留空=OpenAI官方, 或填 https://api.deepseek.com/v1)
#   LLM_MODEL=gpt-4o-mini    (或 deepseek-chat)

OPENAI_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b

# --- Whisper 模型 ---
# 可选: tiny / base / small / medium / large-v3
# 本地开发用 base，生产用 large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# WHISPER_DEVICE=cuda

# --- AI 配音（暂不使用）---
# ELEVENLABS_API_KEY=

# --- Whisper 模型 ---
# 可选: tiny / base / small / medium / large-v3
# 本地开发用 base，生产用 large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# WHISPER_DEVICE=cuda

# --- 对象存储 ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aishot-videos

# --- API Gateway 回调地址 ---
API_GATEWAY_URL=http://api-gateway:8080/api/v1

# --- 日志 ---
LOG_LEVEL=INFO
